#include <stdio.h>

int main() {
    int opcao;
    float saldo = 0;

    do {
        printf("\n1 - Adicionar R$ 0,50\n");
        printf("2 - Adicionar R$ 1,00\n");
        printf("3 - Adicionar R$ 2,00\n");
        printf("0 - Encerrar\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        if (opcao == 1)
            saldo += 0.50;
        else if (opcao == 2)
            saldo += 1.00;
        else if (opcao == 3)
            saldo += 2.00;
        else if (opcao != 0)
            printf("Opcao invalida!\n");

    } while (opcao != 0);

    printf("Total acumulado: R$ %.2f\n", saldo);
    return 0;
}
